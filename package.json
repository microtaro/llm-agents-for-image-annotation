{
  "name": "llm-agents-for-image-annotation",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "agent_app/ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=agent_app/ui",
    "start": "uv run --project agent_app --locked --no-dev python -m agent_app.launch",
    "dev:ui": "npm run dev --workspace=agent_app/ui",
    "test": "npm-run-all test:ui test:server",
    "test:ui": "npm run test --workspace=agent_app/ui",
    "test:server": "uv run --project agent_app --locked pytest agent_app/tests",
    "type-check": "npm run type-check --workspace=agent_app/ui",
    "lint": "uv run --project agent_app --locked ruff check agent_app && uv run --project agent_app --locked ruff format --check agent_app && vp check agent_app vite.config.ts"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
